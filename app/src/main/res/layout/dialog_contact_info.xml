<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:padding="16dp">

    <!-- Email -->
    <TextView
        android:id="@+id/emailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/emailEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter your email"
        android:textColor="@color/black"
        android:textColorHint="@color/grey"
        android:inputType="none"
    android:focusable="false"
    android:clickable="false"
    android:enabled="false"
    android:layout_marginBottom="16dp"
    android:drawableStart="@drawable/ic_email"
    android:drawablePadding="8dp"
    app:layout_constraintTop_toBottomOf="@id/emailLabel"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- LinkedIn -->
    <TextView
        android:id="@+id/linkedInLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LinkedIn"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/emailEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/linkedInEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter your LinkedIn profile"
        android:textColor="@color/black"
        android:textColorHint="@color/grey"
        android:inputType="text"
        android:layout_marginBottom="16dp"
        android:drawableStart="@drawable/linkedin"
        android:drawablePadding="8dp"
        app:layout_constraintTop_toBottomOf="@id/linkedInLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GitHub -->
    <TextView
        android:id="@+id/githubLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GitHub"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/linkedInEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/githubEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter your GitHub profile"
        android:textColor="@color/black"
        android:textColorHint="@color/grey"
        android:inputType="text"
        android:layout_marginBottom="16dp"
        android:drawableStart="@drawable/github"
        android:drawablePadding="8dp"
        app:layout_constraintTop_toBottomOf="@id/githubLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Phone -->
    <TextView
        android:id="@+id/phoneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/githubEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/phoneEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter your phone number"
        android:textColor="@color/black"
        android:textColorHint="@color/grey"
        android:inputType="phone"
        android:layout_marginBottom="16dp"
        android:drawableStart="@drawable/baseline_local_phone_24"
        android:drawablePadding="8dp"
        app:layout_constraintTop_toBottomOf="@id/phoneLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Save and Cancel Buttons -->
    <Button
        android:id="@+id/saveButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Save"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/primaryColor"
        android:layout_marginTop="8dp"
        android:enabled="false"
    app:layout_constraintTop_toBottomOf="@id/phoneEditText"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toStartOf="@id/cancelButton"
    app:layout_constraintHorizontal_bias="0.5" />

    <Button
        android:id="@+id/cancelButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/grey"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/phoneEditText"
        app:layout_constraintStart_toEndOf="@id/saveButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>