<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ScrollView to make the content scrollable -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottom_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- CardView -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView"
                    android:layout_width="match_parent"
                    android:layout_height="290dp"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="9dp">

                    <!-- Add your content inside the CardView -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/card"
                        android:gravity="center">

                        <!-- Image -->
                        <ImageView
                            android:id="@+id/profileImage"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_marginBottom="9dp"
                            android:src="@drawable/profile" />

                        <!-- Name and Edit Icon Row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="8dp">

                            <!-- Name -->
                            <TextView
                                android:id="@+id/profileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="James Parker"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white" />

                            <!-- Edit Icon -->
                            <ImageView
                                android:id="@+id/editIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_edit_square_24"
                                android:layout_marginStart="8dp"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Job Title -->
                        <TextView
                            android:id="@+id/jobTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UI/UX Designer"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            android:layout_marginBottom="8dp" />

                        <!-- Faculty and University -->
                        <TextView
                            android:id="@+id/facultyText"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Faculty of Mechanical Engineering, University of California"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            android:layout_marginBottom="6dp" />

                        <!-- Address and Contact Info Row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="1dp">

                            <!-- Address -->
                            <TextView
                                android:id="@+id/addressText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Berkeley, United States"
                                android:textSize="13sp"
                                android:textColor="@android:color/white" />

                            <!-- Contact Info (Clickable Text) -->
                            <TextView
                                android:id="@+id/contactInfoButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contact Info"
                                android:textSize="13sp"
                                android:textColor="@android:color/white"
                                android:layout_marginStart="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="onContactInfoClick" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Horizontal Line -->
                <View
                    android:id="@+id/horizontalLine1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#57000000"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp" />

                <!-- TextView: My Files -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Files"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="16dp" />

                <!-- Horizontal ScrollView for CV/Portfolio -->
                <HorizontalScrollView
                    android:id="@+id/horizontalScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:id="@+id/horizontalLinearLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"

                        android:padding="8dp">

                        <!-- CV Box -->
                        <LinearLayout
                            android:id="@+id/cvBox"
                            android:layout_width="wrap_content"
                            android:layout_height="80dp"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:background="@drawable/box_background"
                            android:layout_marginEnd="16dp"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClick="onCvClick">

                            <ImageView
                                android:id="@+id/cvIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_cv"
                                android:scaleType="centerCrop"
                                android:contentDescription="CV Icon"
                                android:layout_marginEnd="8dp"
                                android:visibility="visible" />

                            <!-- CV Name -->
                            <TextView
                                android:id="@+id/cvName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" CV                                 "
                                android:textSize="14sp"
                                android:textColor="@android:color/black"
                                android:gravity="start"
                                android:layout_marginEnd="8dp" />

                            <!-- Upload/Edit Icon -->
                            <ImageView
                                android:id="@+id/cvUploadIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_upload_file_24"
                                android:scaleType="centerCrop"
                                android:contentDescription="Upload Icon"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="onUploadCvClick" />
                        </LinearLayout>

                        <!-- Portfolio Box -->
                        <LinearLayout
                            android:id="@+id/portfolioBox"
                            android:layout_width="wrap_content"
                            android:layout_height="80dp"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:background="@drawable/box_background"
                            android:layout_marginEnd="16dp"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClick="onPortfolioClick">

                            <!-- Portfolio Name -->
                            <TextView
                                android:id="@+id/portfolioName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" upload Portfolio"
                                android:textSize="14sp"
                                android:textColor="@android:color/black"
                                android:gravity="start"
                                android:layout_marginEnd="8dp" />

                            <!-- Portfolio Icon -->
                            <ImageView
                                android:id="@+id/portfolioIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_portfolio"
                                android:scaleType="centerCrop"
                                android:contentDescription="Portfolio Icon"
                                android:layout_marginEnd="8dp"
                                android:visibility="visible" />

                            <!-- Upload/Edit Icon -->
                            <ImageView
                                android:id="@+id/portfolioUploadIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_upload_file_24"
                                android:scaleType="centerCrop"
                                android:contentDescription="Upload Icon"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="onUploadPortfolioClick" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Horizontal Line -->
                <View
                    android:id="@+id/horizontalLine"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#57000000"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp" />



                <!-- TextView: Saved Jobs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saved Jobs"
                        android:textSize="20dp"
                        android:textStyle="bold" />

                    <!-- "See More" Button -->
                    <TextView
                        android:id="@+id/seeMoreSavedJobs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="See More"
                        android:textSize="14sp"
                        android:textColor="@color/primaryColor"
                        android:gravity="end"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="onSeeMoreSavedJobsClick" />
                </LinearLayout>

                <!-- Horizontal ScrollView for Saved Jobs -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <!-- Saved Job 1 -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp"
                            android:background="@drawable/card"> <!-- Set background to white -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp"

                                android:background="@android:color/white"> <!-- Set background to white -->

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Android Developer"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ROBUSTA"
                                    android:textSize="14sp"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Alexandria, Egypt (Remote)"
                                    android:textSize="12sp"
                                    android:layout_marginTop="8dp" />

                                <Button
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Apply"
                                    app:cardCornerRadius="8dp"
                                    android:layout_marginTop="16dp"
                                    android:backgroundTint="@color/primaryColor"
                                    android:textColor="@android:color/white" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
     <!-- Saved Job 2 -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Android Developer"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ROBUSTA"
                                    android:textSize="14sp"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Alexandria, Egypt (Remote)"
                                    android:textSize="12sp"
                                    android:layout_marginTop="8dp" />

                                <Button
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Apply"
                                    app:cardCornerRadius="8dp"
                                    android:layout_marginTop="16dp"
                                    android:backgroundTint="@color/primaryColor"
                                    android:textColor="@android:color/white" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>


                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Horizontal Line -->
                <View
                    android:id="@+id/horizontalLine3"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#57000000"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp" />

                <!-- TextView: Track Applications Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track Applications Status"
                        android:textSize="20dp"
                        android:textStyle="bold" />

                    <!-- "See More" Button -->
                    <TextView
                        android:id="@+id/seeMoreTrackApplications"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="See More"
                        android:textSize="14sp"
                        android:textColor="@color/primaryColor"
                        android:gravity="end"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="onSeeMoreTrackApplicationsClick" />
                </LinearLayout>

                <!-- Horizontal ScrollView for Track Applications Status -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp">
                        <!-- track Job 1 -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Android Developer"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ROBUSTA"
                                    android:textSize="14sp"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Alexandria, Egypt (Remote)"
                                    android:textSize="12sp"
                                    android:layout_marginTop="8dp" />

                                <Button
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Under evaluation"
                                    android:layout_marginTop="16dp"
                                    app:cardCornerRadius="8dp"
                                    android:backgroundTint="@color/primaryColor"
                                    android:textColor="@android:color/white" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <!-- track Job 2 -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Android Developer"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ROBUSTA"
                                    android:textSize="14sp"
                                    android:layout_marginTop="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Alexandria, Egypt (Remote)"
                                    android:textSize="12sp"
                                    android:layout_marginTop="8dp" />

                                <Button
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Refuse"
                                    android:layout_marginTop="16dp"
                                    android:backgroundTint="#C20A0A"
                                    app:cardCornerRadius="8dp"
                                    android:textColor="@android:color/white" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Add your track applications content here -->
                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </ScrollView>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:id="@+id/frameContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottom_menu" />

        <!-- BottomNavigationView -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_menu"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:background="#0554A1"
            app:menu="@menu/bottom_menu"
            app:itemIconTint="@color/bottom_nav_item_colors"
            app:itemTextColor="@color/bottom_nav_item_colors"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>